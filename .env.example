DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=explorer
DB_PORT=5432

# Token chain sync (libp2p direct — no proxy, no API key, no TLS)
#
# Transport: HTTP-over-libp2p. The explorer's local IPFS daemon uses
# p2p-forward to bridge the fullnode's /x/RubixFullnodeSyncAPI/1.0 stream
# protocol to a local TCP port; sync then POSTs to that port. The fullnode
# does not need any public HTTP endpoint.
#
# Prerequisites:
#   - The local IPFS daemon has Experimental.Libp2pStreamMounting=true
#     (set automatically by the explorer's IPFSManager).
#   - The swarm key matches the fullnode (testnet vs mainnet — same flag
#     you start the explorer with: -testnet or the default mainnet key).

# Optional: pin a specific fullnode peer ID (base58 / 12D3KooW...). If left
# blank, the explorer fetches the registry below and picks the first Active
# peer matching the network (mainnet/testnet — determined by the -testnet flag).
TOKEN_SYNC_FULLNODE_PEER_ID=

# Optional: registry of fullnode peer IDs. Default points at the canonical
# Rubix-published list. Override only if you maintain a private fork.
TOKEN_SYNC_FULLNODE_PEERS_URL=https://raw.githubusercontent.com/rubixchain/assets/refs/heads/main/fullnodes.json

# Optional: local TCP port used for the p2p-forward bridge. Pick something
# unused on the explorer host. Default 7100.
TOKEN_SYNC_LOCAL_BRIDGE_PORT=7100

# Sync cadence (periodic mode — currently only triggered via -sync flag).
TOKEN_SYNC_INTERVAL=5m
TOKEN_SYNC_HTTP_TIMEOUT=110s
TOKEN_SYNC_TOKEN_LIMIT=500
TOKEN_SYNC_BATCH_DELAY=1m
TOKEN_SYNC_ENABLED=true
